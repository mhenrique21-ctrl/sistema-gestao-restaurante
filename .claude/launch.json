{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "delivery-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "delivery-app"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "delivery-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "delivery-backend"],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "erp-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["new_server.js"],
      "port": 3000,
      "autoPort": false,
      "cwd": "app-gestao-wt"
    },
    {
      "name": "app-gestao-wt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5174"],
      "port": 5174,
      "autoPort": false,
      "cwd": "app-gestao-wt"
    },
    {
      "name": "seama-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["src/server.js"],
      "port": 4100,
      "autoPort": false,
      "cwd": "seama-backend"
    },
    {
      "name": "app-gestao-wt-server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["new_server.js"],
      "port": 3001,
      "autoPort": false,
      "cwd": "app-gestao-wt",
      "env": { "PORT": "3001" }
    }
  ]
}
